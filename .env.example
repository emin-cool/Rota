# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env dosyasını asla commit'leme.

# İstemcide kullanılabilir (EXPO_PUBLIC_ önekli)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxx

# Sadece build için (Mapbox SDK indirme)
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.xxxx

# Sadece sunucu tarafı — Supabase secret olarak ekle:
#   supabase secrets set ORS_API_KEY=xxxx
ORS_API_KEY=
